  "actions": [
    { "id": "decoy", "cost": { "hours": 3, "dc": 3 }, "requires": [{ "ref": "has.decoy", "op": "eq", "value": true }], "effects": [{ "type": "exposure.change", "target": "exposure", "value": -1 }] },
    { "id": "service", "cost": { "hours": 1, "dc": 4 }, "requires": [{ "ref": "is.night", "op": "eq", "value": true }], "effects": [] },
    { "id": "partycar", "cost": { "hours": 1, "dc": 2 }, "requires": [{ "ref": "has.influence", "op": "eq", "value": true }], "effects": [{ "type": "ally.commit", "target": "aide", "value": true }] },
    { "id": "gov.ask", "cost": { "hours": 6 }, "effects": [] }
